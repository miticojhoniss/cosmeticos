{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    },
    {
      "source": "/",
      "destination": "/api/render?p="
    },
    {
      "source": "/:path((?!api/|assets/|products\\.json$|robots\\.txt$|app\\.html$).+)",
      "destination": "/api/render?p=:path"
    }
  ],
  "functions": {
    "api/render.js": {
      "includeFiles": "app.html"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cosmeticos-fawn.vercel.app"
        }
      ],
      "destination": "https://maltacosmeticos.online/:path*",
      "permanent": true
    }
  ]
}